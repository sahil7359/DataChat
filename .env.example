# DataChat — environment variables. Placeholders only; never commit a real .env.
#
# EVERY variable the app reads is prefixed DATACHAT_ (Settings.env_prefix).
# An unprefixed name is silently ignored — that is the single most common reason
# a deploy "doesn't pick up" a value.
#
# Local dev works with DATACHAT_USE_MOCKS=true and NO real keys.
# For go-live, see GOLIVE.md.

# ---- App ----
DATACHAT_ENVIRONMENT=dev                 # dev | staging | production
DATACHAT_LOG_LEVEL=INFO
DATACHAT_USE_MOCKS=true                  # true = keyless mock provider for local dev & tests

# ---- Database (local Postgres, or Neon in prod) ----
# NOTE the driver: postgresql+asyncpg://  (not postgresql://)
# NOTE on Neon: asyncpg does not understand libpq's ?sslmode=require. Drop the
# query string entirely (Neon negotiates TLS), or use ?ssl=require if needed.
DATACHAT_DATABASE_URL=postgresql+asyncpg://datachat:datachat@localhost:5432/datachat
# The read-only executor role. Same host/db, user datachat_exec. Created by the
# 0003_roles_grants migration using the password below — the two MUST match.
DATACHAT_EXECUTOR_DATABASE_URL=postgresql+asyncpg://datachat_exec:CHANGE_ME@localhost:5432/datachat
DATACHAT_EXECUTOR_ROLE_PASSWORD=CHANGE_ME

# ---- Cache / rate-limit (local Redis, or Upstash in prod) ----
DATACHAT_REDIS_URL=redis://localhost:6379/0

# ---- LLM providers ----
# A provider is registered only if its key is present, so setting GROQ alone makes
# Groq the sole provider for every task. With no key AND Ollama disabled the app
# falls back to the mock and logs `no_llm_provider_configured` — if every answer
# looks identical, that is why.
DATACHAT_GROQ_API_KEY=
DATACHAT_GEMINI_API_KEY=
DATACHAT_OPENROUTER_API_KEY=
DATACHAT_OPENROUTER_ENABLED=false
DATACHAT_PROVIDER_ORDER=gemini,groq      # fallback order when both are present

# ---- Self-hosted Ollama (optional; leads over cloud providers when enabled) ----
# Local, no tunnel:  http://localhost:11434/v1  (bare uvicorn)
#                    http://host.docker.internal:11434/v1  (from a container)
# Through the Caddy + Cloudflare tunnel: https://<host>.trycloudflare.com/v1
DATACHAT_OLLAMA_ENABLED=false
DATACHAT_OLLAMA_BASE_URL=http://localhost:11434/v1
DATACHAT_OLLAMA_API_KEY=                 # must match the Caddy bearer token; blank = no auth header
DATACHAT_OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- Embeddings ----
# With no Gemini key this falls back to the deterministic local hash embedder,
# which is what the seeded catalog was built with. Keep them consistent: changing
# embedder without re-running ingestion silently degrades retrieval.
DATACHAT_EMBEDDING_MODEL=text-embedding-004
DATACHAT_EMBEDDING_DIM=768

# ---- Web-search fallback (optional) ----
# Untrusted results are injection-fenced and never touch the SQL path.
# Leave off until the golden set separates "must refuse" from "must escalate".
DATACHAT_WEB_SEARCH_ENABLED=false
DATACHAT_WEB_SEARCH_PROVIDER=ddgs        # mock | ddgs

# ---- Agent / safety limits ----
DATACHAT_MAX_REPAIR_ATTEMPTS=2
DATACHAT_ROW_CAP=1000
DATACHAT_STATEMENT_TIMEOUT_MS=5000
DATACHAT_LLM_TIMEOUT_S=30
DATACHAT_RETRIEVAL_K=8
DATACHAT_APPROVE_SQL_DEFAULT=false
DATACHAT_ANSWER_CACHE_TTL_S=3600

# ---- Abuse protection ----
DATACHAT_RATE_LIMIT_PER_MIN=20
DATACHAT_GLOBAL_DAILY_QUOTA=1000         # caps total LLM calls/day to protect free tiers
DATACHAT_BREAKER_FAIL_THRESHOLD=5
DATACHAT_BREAKER_COOLDOWN_S=30
DATACHAT_DATA_RETENTION_DAYS=90

# ---- Observability (MLflow; optional) ----
DATACHAT_MLFLOW_TRACKING_URI=http://localhost:5000
# Telemetry must never gate readiness: startup gives up after this many seconds
# if the tracking server is unreachable.
DATACHAT_MLFLOW_STARTUP_TIMEOUT_S=5

# ---- CORS: the frontend origin(s) allowed to call the API ----
DATACHAT_CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Vercel env, not read by the backend) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
