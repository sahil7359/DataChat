# DataChat — environment variables (safe placeholders only; never commit a real .env)
# Local dev works with USE_MOCKS=true and NO real keys.

# ---- App ----
APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
BUILD_MODE=autonomous         # autonomous | checkpointed  (see Rules.md §1)
USE_MOCKS=true                # true = mock LLM/embeddings/providers for local dev & tests

# ---- Databases (Postgres / Neon) ----
# app_rw role: migrations + app-schema CRUD
DATABASE_URL=postgresql+asyncpg://app_rw:CHANGE_ME@localhost:5432/datachat
# datachat_exec role: READ-ONLY, statement_timeout, analytics schema only
ANALYTICS_DATABASE_URL=postgresql+asyncpg://datachat_exec:CHANGE_ME@localhost:5432/datachat

# ---- Cache / rate-limit (Redis / Upstash) ----
REDIS_URL=redis://localhost:6379/0

# ---- LLM providers (create at go-live; see GOLIVE.md) ----
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=            # optional; leave empty to stay strictly $0
LLM_PROVIDER_ORDER=gemini,groq # fallback order
LLM_MODEL_PRIMARY=gemini-3-flash
LLM_MODEL_FALLBACK=llama-3.3-70b-versatile
EMBEDDING_PROVIDER=gemini      # gemini | local_bge
EMBEDDING_DIM=768

# ---- Self-hosted Ollama (primary AI; the Docker stack reads these DATACHAT_ vars) ----
# Flip the whole stack to your own GPU. See DEPLOY.md. Keep a Gemini/Groq key unset
# to keep embeddings hash-based (matching the seeded catalog).
DATACHAT_USE_MOCKS=false
DATACHAT_OLLAMA_ENABLED=true
DATACHAT_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
DATACHAT_OLLAMA_API_KEY=local-dev          # any string for a direct local Ollama; the tunnel token in prod
DATACHAT_OLLAMA_MODEL=qwen2.5:7b-instruct  # or llama3.2 — must be `ollama pull`ed

# ---- Web-search fallback (optional; answers out-of-scope questions from the web) ----
# Untrusted results are injection-fenced and never touch the SQL path. provider: mock | ddgs
DATACHAT_WEB_SEARCH_ENABLED=false
DATACHAT_WEB_SEARCH_PROVIDER=ddgs
# Whole-answer cache TTL in seconds (repeat questions replay instantly).
DATACHAT_ANSWER_CACHE_TTL_S=3600

# ---- Agent / safety limits ----
MAX_REPAIR_ATTEMPTS=2
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_S=5
HISTORY_WINDOW_TURNS=6

# ---- Abuse protection ----
RATE_LIMIT_PER_MIN=20
GLOBAL_DAILY_QUOTA=1000        # cap total LLM calls/day to protect free tiers
DATA_RETENTION_DAYS=90

# ---- Observability (MLflow) ----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
